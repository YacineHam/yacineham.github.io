---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { t, localePath, slugOf, type Locale } from '../i18n/ui';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { Content } = await render(project);
const path = `/projects/${slugOf(project.id)}`;
---

<Base
  locale={locale}
  path={path}
  title={`${project.data.title} — Yacine Hamitou`}
  description={project.data.summary}
>
  <article class="prose">
    <a class="back-link" href={localePath(locale, '/') + '#projects'}>
      {t(locale, 'projects.back')}
    </a>
    <h1>{project.data.title}</h1>
    <p class="meta">
      {project.data.year} · {project.data.tags.join(' · ')}
      {project.data.repo && <> · <a href={project.data.repo}>repo</a></>}
      {project.data.link && <> · <a href={project.data.link}>live</a></>}
    </p>
    <Content />
  </article>
</Base>

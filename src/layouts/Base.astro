---
import '../styles/global.css';
import { t, localePath, type Locale } from '../i18n/ui';
import { site } from '../site';

interface Props {
  locale: Locale;
  /** Path without locale prefix, e.g. "/" or "/projects/okadoo" — used by the lang switcher. */
  path: string;
  title?: string;
  description?: string;
  /** Set on pages that should stay out of search results (404). */
  noindex?: boolean;
}

const { locale, path, title, description, noindex = false } = Astro.props;
const pageTitle = title ?? t(locale, 'meta.title');
const pageDescription = description ?? t(locale, 'meta.description');
const otherLocale: Locale = locale === 'fr' ? 'en' : 'fr';
const canonical = new URL(localePath(locale, path), Astro.site);
const cv = site.cv[locale];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: locale === 'fr' ? 'Ingénieur IA' : 'AI Engineer',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Paris', addressCountry: 'FR' },
  sameAs: [site.github, site.linkedin],
  knowsAbout: site.stack,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={locale === 'fr' ? 'fr_FR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="fr" href={new URL(localePath('fr', path), Astro.site)} />
          <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('fr', path), Astro.site)} />
        </>
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // Set theme before first paint to avoid a flash.
      // Default to dark (the site's primary look); users can toggle to light.
      (() => {
        let theme = 'dark';
        try {
          theme = localStorage.getItem('theme') ?? 'dark';
        } catch {}
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{locale === 'fr' ? 'Aller au contenu' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={localePath(locale, '/')}>~/yacine-hamitou</a>
        <nav aria-label={locale === 'fr' ? 'Navigation principale' : 'Main navigation'}>
          <a href={localePath(locale, '/') + '#projects'}>{t(locale, 'nav.projects')}</a>
          <a href={localePath(locale, '/') + '#changelog'}>{t(locale, 'nav.changelog')}</a>
          <a href={localePath(locale, '/') + '#certifications'}>{t(locale, 'nav.certs')}</a>
          <a href={cv.path} download={cv.filename}>{t(locale, 'nav.resume')}</a>
          <a href={localePath(otherLocale, path)} rel="alternate" hreflang={otherLocale} lang={otherLocale}>
            {t(locale, 'lang.switch')}
          </a>
          <button id="theme-toggle" type="button" aria-label={t(locale, 'theme.toggle')}>◐</button>
        </nav>
      </div>
    </header>

    <main id="main" class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© {new Date().getFullYear()} {site.name} · {t(locale, 'footer.builtWith')}</span>
        <span class="footer-links">
          <a href={`mailto:${site.email}`}>Email</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </span>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
